  },
  "automation": {
    "intervals": {
      "NFL": 900,
      "NBA": 900,
      "NHL": 900
    },
    "retry_seconds": 60,
    "max_cycle_seconds": 7200,
    "nba_provider": "auto",
    "approvals_dir": "docs"
  }
}
